<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apps_list_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Never shown — exists only because FloatingHeaderView requires a
         real, bound AllAppsRecyclerView to hook its scroll listener to.
         GONE views get no measure/layout pass, so this costs nothing
         visually or in layout time. -->
    <com.android.launcher3.allapps.AllAppsRecyclerView
        android:id="@+id/apps_list_view_hidden_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false" />

    <app.lawnchair.allapps.AllAppsPagedGridView
        android:id="@+id/apps_paged_grid_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true" />

</FrameLayout>
